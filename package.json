{
	"name": "stella",
	"private": true,
	"description": "Stella — a React-first, Tauri-optimized UI kit. @stella/terra (base) + @stella/vidrio (aesthetic expansion).",
	"license": "MIT",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"build": "pnpm -r --if-present run build",
		"dev": "pnpm -r --if-present run dev",
		"lint": "pnpm -r --if-present run lint",
		"typecheck": "pnpm -r --if-present run typecheck",
		"test": "pnpm -r --if-present run test",
		"clean": "pnpm -r --if-present run clean",
		"format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\""
	},
	"devDependencies": {
		"prettier": "^3.9.6"
	}
}