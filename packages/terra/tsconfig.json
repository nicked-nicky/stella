{
	// Build config — what actually gets compiled into dist/ and published.
	// Tests are excluded deliberately: they'd otherwise be emitted as
	// .test.js alongside the components and drag vitest/@playwright types
	// into a consumer's type resolution. Type *checking* of the tests is a
	// separate concern, handled by tsconfig.typecheck.json.
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"inlineSources": true,
		"removeComments": true
	},
	"include": ["src"],
	// `.story.tsx` is here for the same reason as the test files: Playwright
	// CT can't mount a component defined inside a `.ct.tsx`, so its fixtures
	// live in sibling story modules. They are test scaffolding, not part of
	// the public surface, and were shipping into dist/ until this line
	// existed — a package consumer could `import` the SettingsMenu fixture.
	"exclude": [
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/**/*.ct.tsx",
		"src/**/*.story.tsx"
	]
}
